# Generate a unique value for every project with: bunx auth secret
AUTH_SECRET=

# Create a Google OAuth web client and register this local callback URL:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Hono API base URL used by server components and actions.
API_URL=http://localhost:3002

# Public API base the browser can reach, used for OAuth start links (defaults to API_URL).
API_PUBLIC_URL=http://localhost:3002
