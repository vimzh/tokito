# SQLite file used by the API (relative to apps/api).
DB_FILE_NAME=local.db
PORT=3002
# Origin allowed to call the API from the browser.
WEB_ORIGIN=http://localhost:3000
# OpenAI credentials for question drafting (Phase 2) and later conversation work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# CALL-E (heycall-e.com) for real phone calls (Phase 5). Without a key, outreach cannot start.
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
# Public URL of this API for terminal call webhooks, e.g. https://<tunnel>/api/webhooks/calle
CALLE_WEBHOOK_URL=
OUTREACH_TICK_SECONDS=30
# Google (Sheets + Calendar) and Notion OAuth apps (Phase 9). Register these redirect URIs:
#   <API_PUBLIC_URL>/api/connections/google/callback and <API_PUBLIC_URL>/api/connections/notion/callback
API_PUBLIC_URL=http://localhost:3002
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Phase 10 hardening. API_TOKEN: when set, every /api route except health, webhooks, and OAuth
# redirects requires "Authorization: Bearer <token>"; give the same value to the web app and the bot.
API_TOKEN=
# Encrypts stored Google and Notion tokens (AES-256-GCM). Any long random string.
TOKEN_ENCRYPTION_KEY=
